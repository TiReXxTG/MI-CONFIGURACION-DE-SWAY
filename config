# Ejemplo de configuración:
#
# exec swayidle -w \
#     timeout 300 'swaylock -f -c 000000' \
#     timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#     before-sleep 'swaylock -f -c 000000'
#
# ¿Qué hace?
#
# 300 segundos (5 minutos)
# → Bloquea la pantalla
#
# 600 segundos (10 minutos)
# → Apaga los monitores para ahorrar energía
#
# Al mover el ratón o pulsar una tecla
# → Enciende los monitores nuevamente
#
# Antes de suspender el equipo
# → Bloquea la pantalla automáticamente
#
# Para usar esta función necesitas:
# swayidle
# swaylock


