##      EJEMPLO DE CONFIGURACION        ##

    mode "redimensionar" {

        # Reducir ancho
        bindsym $izquierda resize shrink width 10px

        # Aumentar alto
        bindsym $abajo resize grow height 10px

        # Reducir alto
        bindsym $arriba resize shrink height 10px

        # Aumentar ancho
        bindsym $derecha resize grow width 10px

        # O usar las flechas del teclado
        bindsym Left resize shrink width 10px
        bindsym Down resize grow height 10px
        bindsym Up resize shrink height 10px
        bindsym Right resize grow width 10px

        # Volver al modo normal
        bindsym Return mode "default"
        bindsym Escape mode "default"
    }

    # Activar modo de redimensionado
    bindsym $mod+r mode "redimensionar"


