##      EJEMPLO DE CONFIGURACION        ##

##      ESTO ES PARA UNA LAPTOP         ##

    input type:touchpad {

        # Desactivar touchpad mientras se escribe
        dwt enabled

        # Permitir clic tocando el touchpad
        tap enabled

        # Scroll narutal del touchpad
        natural_scroll enabled

        # Simular rueda del Raton CREO XD##
        middle_emulation enabled
    }

    ##   IDIOMA DEL TECLADO ##
    input type:keyboard {
        xkb_layout "latam,cn"
        xkb_options "grp:win_space_toggle"
    }

#
# También es posible configurar cada teclado, ratón o touchpad por separado.
# Consulta "man 5 sway-input" para más detalles sobre esta sección.


