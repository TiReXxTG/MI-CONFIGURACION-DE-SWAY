##	EJEMPLO DE CONFIGURACION	##

    # Terminal kitty
    bindsym $mod+q exec $terminal

    # Explorador de archivos nautilus (Aqui pueden cambiar, pero yo tengo nautilus)
    bindsym $mod+e exec $explorador

    # Navegador (Yo tengo firefox)
    bindsym $mod+w exec $navegador

    # Menú de aplicaciones (Yo manejo rofi)
    bindsym $mod+d exec $menu_aplicaciones

    # Recargar configuración de Sway
    bindsym $mod+z reload

    # Cerrar ventana actual (literalmente ejecuta PKILL)
    bindsym $mod+s kill

    # Captura de pantalla
    bindsym $mod+p exec grim -g "$(slurp)" - | satty --filename -

    # Cerrar sesión de Sway
    bindsym $mod+m exec swaynag -t warning -m '¿Seguro que quieres cerrar la sesión de Sway?' -B 'Sí, salir' 'swaymsg exit'
#

