#
    # Mover el foco entre ventanas (estilo Vim)
    bindsym $mod+$izquierda focus left
    bindsym $mod+$abajo focus down
    bindsym $mod+$arriba focus up
    bindsym $mod+$derecha focus right

    # O usar las flechas del teclado
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Mover la ventana enfocada (estilo Vim)
    bindsym $mod+Shift+$izquierda move left
    bindsym $mod+Shift+$abajo move down
    bindsym $mod+Shift+$arriba move up
    bindsym $mod+Shift+$derecha move right

    # O usar las flechas del teclado
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#


